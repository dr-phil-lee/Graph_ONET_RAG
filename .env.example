# Copy to .env (gitignored). Never commit real keys.

# Default OpenRouter key used by the UI and by API requests that send none.
OPENROUTER_API_KEY=
# Default OpenRouter model id (UI / API callers can override per request).
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# REST API (api.py). If CHATBOT_API_TOKEN is set, every request except
# /health must send:  Authorization: Bearer <token>
CHATBOT_API_TOKEN=
# Comma-separated browser origins allowed to call the API (default: *).
CHATBOT_CORS_ORIGINS=*
# Optional folder where API conversation memory (sessions) is saved as JSON
# so it survives a restart. Empty = in memory only.
CHATBOT_SESSION_DIR=
